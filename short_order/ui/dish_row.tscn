[gd_scene load_steps=4 format=3]

[ext_resource type="Theme" path="res://ui/theme.tres" id="0_theme"]
[ext_resource type="Script" path="res://ui/dish_row.gd" id="1_script"]
[ext_resource type="Script" path="res://ui/widgets/art_icon.gd" id="2_art"]

[node name="DishRow" type="PanelContainer"]
theme = ExtResource("0_theme")
theme_type_variation = &"Card"
script = ExtResource("1_script")

[node name="Row" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="Icon" type="Control" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(34, 34)
layout_mode = 2
size_flags_vertical = 4
mouse_filter = 2
script = ExtResource("2_art")

[node name="Info" type="VBoxContainer" parent="Row"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 0

[node name="NameRow" type="HBoxContainer" parent="Row/Info"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Name" type="Label" parent="Row/Info/NameRow"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"StatLabel"
text = "Burger"

[node name="Note" type="Label" parent="Row/Info"]
unique_name_in_owner = true
custom_minimum_size = Vector2(60, 0)
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Usual price $9"
autowrap_mode = 3

[node name="Price" type="SpinBox" parent="Row"]
unique_name_in_owner = true
custom_minimum_size = Vector2(92, 0)
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "Price. Customers compare it with the usual price: much more and reviews drop, a bit less and they're pleased."
min_value = 0.5
max_value = 40.0
step = 0.5
value = 9.0
prefix = "$"

[node name="On" type="CheckButton" parent="Row"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
tooltip_text = "On the menu"
button_pressed = true

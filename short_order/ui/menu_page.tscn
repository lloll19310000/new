[node name="Intro" type="Label" parent="Box"]
layout_mode = 2
theme_type_variation = &"MutedLabel"
text = "Switch dishes on or off and set their prices. Each dish needs its station in the kitchen."
autowrap_mode = 3

[node name="Rows" type="VBoxContainer" parent="Box"]
unique_name_in_owner = true
layout_mode = 2
